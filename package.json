{
  "name": "lagos-uber-driver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src tests *.ts *.json index.html"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
